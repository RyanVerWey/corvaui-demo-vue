    "vite": "^8.2.2",
    "typescript": "^5.8.3",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "axe-core": "^4.13.0",
    "vitest": "^4.1.11"
  }
}
